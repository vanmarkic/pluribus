{
  "name": "mailclient",
  "version": "0.1.0",
  "description": "Privacy-focused mail client with LLM-powered tagging",
  "author": "Pluribus",
  "license": "PROPRIETARY",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run rebuild:electron && tsc -p tsconfig.main.json && mkdir -p dist/adapters/db/migrations && cp src/adapters/db/schema.sql dist/adapters/db/ && cp -r src/adapters/db/migrations/* dist/adapters/db/migrations/ 2>/dev/null || true && electron .",
    "build": "rm -f tsconfig.main.tsbuildinfo && tsc -p tsconfig.main.json && mkdir -p dist/adapters/db/migrations && cp src/adapters/db/schema.sql dist/adapters/db/ && cp -r src/adapters/db/migrations/* dist/adapters/db/migrations/ 2>/dev/null || true && vite build",
    "build:demo": "vite build --mode demo",
    "start": "npm run rebuild:electron && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run rebuild:node && vitest run",
    "test:watch": "npm run rebuild:node && vitest",
    "eval": "tsc -p tsconfig.evals.json && node dist/evals/run-eval.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "dist": "npm run build && npm run rebuild:electron && electron-builder --mac",
    "dist:dmg": "npm run build && npm run rebuild:electron && electron-builder --mac dmg",
    "rebuild:electron": "electron-rebuild",
    "rebuild:node": "npm rebuild better-sqlite3",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,yml,yaml,css,md}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.pluribus.mailclient",
    "productName": "Mail",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/adapters/db/schema.sql",
        "to": "schema.sql"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "dmg": {
      "title": "${productName}-${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/react-window": "^1.8.2",
    "@xenova/transformers": "^2.17.2",
    "ai": "^6.0.168",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.1.0",
    "electron-store": "^8.2.0",
    "imapflow": "^1.0.164",
    "mailparser": "^3.7.1",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^7.0.11",
    "obra-icons-react": "^1.23.1",
    "pino": "^9.5.0",
    "react-redux": "^9.2.0",
    "react-window": "^1.8.10",
    "sanitize-filename": "^1.6.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/dompurify": "^3.0.5",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.0.15",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.34.5",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.15"
  }
}
